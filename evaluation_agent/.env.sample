# VoiceLive Evaluation Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Azure AI Foundry Project
# =============================================================================
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# =============================================================================
# REQUIRED - Voice Live API (for running evaluations)
# =============================================================================
AZURE_VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com/
AZURE_VOICE_LIVE_MODEL=gpt-realtime
AZURE_VOICE_LIVE_API_VERSION=2025-10-01
# AZURE_VOICE_LIVE_API_KEY=  # Optional if using Managed Identity

# =============================================================================
# REQUIRED - Azure OpenAI (for metrics evaluation)
# =============================================================================
AOAI_DEPLOYMENT_NAME=gpt-4o-mini
AOAI_REASONING_DEPLOYMENT_NAME=o4-mini

# =============================================================================
# OPTIONAL - Agent Configuration
# =============================================================================
# EVAL_AGENT_OUTPUT_DIR=./output      # Output directory for results
# EVAL_AGENT_LOG_DIR=./logs           # Log directory
# EVAL_AGENT_LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR
# EVAL_AGENT_MAX_WORKERS=4            # Parallel workers (max recommended: 8)

# =============================================================================
# OPTIONAL - Azure Monitor Tracing
# =============================================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.in.applicationinsights.azure.com/
