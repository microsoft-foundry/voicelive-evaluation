# Azure VoiceLive
AZURE_VOICELIVE_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_VOICELIVE_MODEL=gpt-realtime

# Blob Storage
AZURE_STORAGE_ACCOUNT=stv3g7ywvldzjeo
AZURE_STORAGE_DATASETS_CONTAINER=datasets
AZURE_STORAGE_OUTPUTS_CONTAINER=outputs

# Optional overrides
# VOICELIVE_DEFAULT_VOICE=en-US-Ava:DragonHDLatestNeural
# AUDIO_SAMPLE_RATE=24000

# --- Agent Mode (Foundry Agent integration) ---
# Uncomment to enable agent mode instead of model mode
# AGENT_NAME=voicelive-demo-agent
# PROJECT_NAME=your-project-name
# AGENT_VERSION=
# FOUNDRY_RESOURCE_OVERRIDE=
# AGENT_AUTHENTICATION_IDENTITY_CLIENT_ID=
