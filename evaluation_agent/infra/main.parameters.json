{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "createFoundry": {
      "value": "${CREATE_FOUNDRY=true}"
    },
    "projectEndpoint": {
      "value": "${PROJECT_ENDPOINT=}"
    },
    "foundryAccountName": {
      "value": "${FOUNDRY_ACCOUNT_NAME=}"
    },
    "foundryProjectName": {
      "value": "${FOUNDRY_PROJECT_NAME=}"
    },
    "deployContainerApp": {
      "value": "${DEPLOY_CONTAINER_APP=true}"
    },
    "enableEntraAuth": {
      "value": "${ENABLE_ENTRA_AUTH=false}"
    },
    "entraClientId": {
      "value": "${ENTRA_CLIENT_ID=}"
    },
    "voiceLiveEndpoint": {
      "value": "${AZURE_VOICE_LIVE_ENDPOINT=}"
    },
    "voiceLiveModel": {
      "value": "${AZURE_VOICE_LIVE_MODEL=gpt-realtime}"
    },
    "voiceLiveApiVersion": {
      "value": "${AZURE_VOICE_LIVE_API_VERSION=2026-01-01-preview}"
    },
    "modelDeploymentName": {
      "value": "${MODEL_DEPLOYMENT_NAME=gpt-4.1-mini}"
    },
    "aoaiDeploymentName": {
      "value": "${AOAI_DEPLOYMENT_NAME=gpt-4.1-mini}"
    },
    "aoaiReasoningDeploymentName": {
      "value": "${AOAI_REASONING_DEPLOYMENT_NAME=o4-mini}"
    },
    "foundryProjectPrincipalId": {
      "value": "${FOUNDRY_PROJECT_PRINCIPAL_ID=}"
    },
    "enableContainerAppAuth": {
      "value": "${ENABLE_CONTAINER_APP_AUTH=true}"
    },
    "containerAppEntraClientId": {
      "value": "${CONTAINER_APP_ENTRA_CLIENT_ID=}"
    },
    "functionAppMiAppId": {
      "value": "${FUNCTION_APP_MI_APP_ID=}"
    }
  }
}
