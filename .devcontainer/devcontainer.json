{
  "name": "VoiceLive Evaluation Harness",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
  "features": {
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/azure-cli:latest": {
      "installBicep": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-bicep",
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "hostRequirements": {
    "memory": "4gb"
  },
  "postCreateCommand": "pip install -r evaluation_harness/requirements.txt && pip install -r evaluation_agent/requirements.txt",
  "forwardPorts": [],
  "remoteEnv": {
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
