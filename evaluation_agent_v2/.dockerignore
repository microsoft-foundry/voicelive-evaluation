# .dockerignore for VoiceLive Evaluation Agent
# Exclude files not needed in the container

# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local data (will use blob storage in cloud)
output/
logs/
temp/
local_datasets/
sample_evaluation_input/
sample_outputs/

# Documentation (not needed at runtime)
*.md
docs/
ARCHITECTURE.md
README.md

# Tests
tests/
*_test.py
test_*.py

# Development files
.env
.env.local
*.log
