# VoiceLive Evaluation — Environment Variables
# Copy this file to .env and fill in your values.
# For the evaluation harness, also copy evaluation_harness/.sample_env

# === Azure Identity (set automatically by azd) ===
# AZURE_SUBSCRIPTION_ID=
# AZURE_LOCATION=eastus2

# === Voice Live Endpoint ===
# Your Azure AI Services endpoint with Voice Live enabled
AZURE_VOICELIVE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_API_VERSION=2026-01-01-preview

# === Azure AI Foundry (set automatically by azd up) ===
# PROJECT_ENDPOINT=https://<your-foundry-project>.cognitiveservices.azure.com

# === Model Deployments (defaults, override if needed) ===
# MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# AOAI_DEPLOYMENT_NAME=gpt-4.1-mini
# AOAI_REASONING_DEPLOYMENT_NAME=o4-mini

# === Optional: API Key Auth (alternative to DefaultAzureCredential) ===
# AZURE_VOICELIVE_API_KEY=

# === Optional: Agent Mode ===
# AGENT_NAME=
# AGENT_PROJECT_NAME=
